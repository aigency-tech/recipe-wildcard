EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-side only (set in Vercel env / `vercel dev`). Never prefix with EXPO_PUBLIC_.
ANTHROPIC_API_KEY=your-anthropic-key
# Native builds only: where the /api functions are deployed. Leave empty for web.
EXPO_PUBLIC_API_URL=https://recipe-wildcard.vercel.app
EXPO_PUBLIC_APP_SCHEME=recipewildcard
